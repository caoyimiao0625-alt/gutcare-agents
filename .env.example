# 复制为 .env（仅本地使用，不要提交）后按需填写；也可以在启动前设置环境变量。
# 运行模式：live（真实调用）/ mock（不联网）/ replay（读录制结果）
GCA_MODE=mock

# ---------------------------------------------------------------------------
# 模型服务（任意 OpenAI 兼容接口；以下三家均实测可用，选一家即可）
# ---------------------------------------------------------------------------
GCA_API_KEY=

# [A] 硅基流动（本项目已验证：文本 + 视觉都通，见 docs/第三方模型与数据使用说明.md §1）
GCA_BASE_URL=https://api.siliconflow.cn/v1
GCA_TEXT_MODEL=Qwen/Qwen3-30B-A3B-Instruct-2507
GCA_VISION_MODEL=Qwen/Qwen3-VL-30B-A3B-Instruct

# [B] 阿里云百炼（国内直连；型号以控制台为准）
# GCA_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# GCA_TEXT_MODEL=qwen-plus
# GCA_VISION_MODEL=qwen-vl-plus

# [C] 智谱
# GCA_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# GCA_TEXT_MODEL=glm-4-plus
# GCA_VISION_MODEL=glm-4v-plus

# [D] 本地 Ollama（零调用费，需要 GPU）
# GCA_BASE_URL=http://127.0.0.1:11434/v1
# GCA_TEXT_MODEL=qwen2.5:14b
# GCA_VISION_MODEL=qwen2.5vl:7b
# GCA_API_KEY=ollama

# 超时与重试：视觉模型（大图）可能 40—150 秒，演示环境建议 180
GCA_TIMEOUT_S=180
GCA_MAX_RETRIES=2

# 测试包与运行目录
GCA_FIXTURE_ROOT=<本机测试包目录>
GCA_HOST=127.0.0.1
GCA_PORT=8100

# 任务库路径（可选）：录制/评测时用干净库，避免幂等复用到旧结果
# GCA_DB=data/record.sqlite3

# 内部鉴权（与业务后端约定；留空表示本地不校验）
GCA_INTERNAL_TOKEN=

# replay 模式缺少录制结果时是否退回 mock（0=报错，1=退回并标注 replay_mock_fallback）
GCA_REPLAY_FALLBACK=0

# 数据充足性门槛（低于门槛必须降级，不允许硬编结论）
GCA_MIN_DAYS=3
GCA_MIN_RECORDS=5
